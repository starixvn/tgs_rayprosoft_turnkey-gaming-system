<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
    <AssemblyName>TGS.Workers.Schedulers</AssemblyName>
    <RootNamespace>TGS.Workers.Schedulers</RootNamespace>
    <DockerfileBuildArguments>--build-arg "BuildConfiguration=$(Configuration)"</DockerfileBuildArguments>
    <DockerfileTag Condition="$(DockerfileTag) == ''">scheduler</DockerfileTag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.7.33" />
    <PackageReference Include="Hangfire.Console" Version="1.4.2" />
    <PackageReference Include="Hangfire.Dashboard.Management" Version="1.7.9" />
    <PackageReference Include="Hangfire.Redis.StackExchange" Version="1.8.6" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.17.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.0.0" />
    <PackageReference Include="prometheus-net.AspNetCore.HealthChecks" Version="8.0.0" />
    <PackageReference Include="TGS.Core.Infrastructures.Mail" Version="0.0.6" />
    <PackageReference Include="Tgs.ProfitRebate.Client" Version="1.0.19" />
    <PackageReference Include="Tgs.Promotion.Client" Version="1.0.41" />
    <PackageReference Include="Tgs.Promotion.RebateService.Client" Version="0.0.3" />
    <PackageReference Include="Tgs.Report.Aggregate.Client" Version="0.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Repositories\GameProviders.Repositories\GameProviders.Repositories.csproj" />
    <ProjectReference Include="..\..\Services\Operations\Operations.csproj" />
    <ProjectReference Include="..\..\Shared\Game.ApiClients\Game.ApiClients.csproj" />
  </ItemGroup>

</Project>
